{
  "extends": ["stylelint-config-standard", "stylelint-config-tailwindcss"],
  "plugins": ["stylelint-order"],
  "rules": {
    "order/order": [
      {
        "type": "at-rule",
        "name": "tailwind"
      },
      "custom-properties",
      "dollar-variables",
      "declarations",
      "rules"
    ],
    "order/properties-order": []
  },
  "overrides": [
    {
      "files": ["**/*.module.css"],
      "rules": {
        "selector-class-pattern": [
          "^[a-z][a-zA-Z0-9]*$",
          {
            "message": "Expected class selector \"%s\" to be camelCase, so it reads as styles.name in TypeScript"
          }
        ]
      }
    }
  ]
}
